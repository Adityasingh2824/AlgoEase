    dup
    box_get
    swap
    cover 2
    assert // check self.escrows entry exists
    // contract.py:258
    // assert Txn.sender == record.client.native, "only client"
    txn Sender
    // contract.py:257-258
    // record = self.escrows[key].copy()
    // assert Txn.sender == record.client.native, "only client"
    dig 1
    intc_0 // 0
    pushint 32
    box_extract // on error: index out of bounds
    // contract.py:258
    // assert Txn.sender == record.client.native, "only client"
    ==
    assert // only client
    // contract.py:260
    // status = record.status.native
    dup
    pushint 80
    intc_2 // 8
    box_extract // on error: index out of bounds
    btoi
    dup
    uncover 2
    // contract.py:261
    // deadline = record.deadline.native
    pushint 98
    intc_2 // 8
    box_extract // on error: index out of bounds
    btoi
    swap
    // contract.py:262
    // now = Global.latest_timestamp
    global LatestTimestamp
    swap
    // contract.py:266
    // status == STATUS_OPEN or status == STATUS_ACCEPTED or status == STATUS_SUBMITTED
    intc_1 // 1
    ==
    bnz refund_bool_true@4
    dig 2
    intc_3 // 2
    ==
    bnz refund_bool_true@4
    dig 2
    pushint 3
    ==
    bz refund_bool_false@5

refund_bool_true@4:
    intc_1 // 1

refund_bool_merge@6:
    // contract.py:268
    // assert is_refundable_status, "refund not allowed"
    assert // refund not allowed
    // contract.py:269-270
    // # After SUBMITTED, require deadline to have passed
    // if status == STATUS_SUBMITTED:
    dig 2
    pushint 3
    ==
    bz refund_after_if_else@8
    // contract.py:271
    // assert now >= deadline, "deadline not reached"
    dup
    dig 2
    >=
    assert // deadline not reached

refund_after_if_else@8:
    // contract.py:273
    // self._refund_client(record, key)
    dig 3
    dig 5
    callsub _refund_client
    pop
    // contract.py:253
    // @arc4.abimethod
    intc_1 // 1
    return

refund_bool_false@5:
    intc_0 // 0
    b refund_bool_merge@6


// algoease_escrow.contract.EscrowContract.get_status[routing]() -> void:
get_status:
    // contract.py:275
    // @arc4.abimethod(readonly=True)
    txna ApplicationArgs 1
    dup
    intc_0 // 0
    extract_uint16 // on error: invalid array length header
    intc_3 // 2
    +
    dig 1
    len
    ==
    assert // invalid number of bytes for arc4.dynamic_array<arc4.uint8>
    // contract.py:279
    // record = self.escrows[key].copy()
    bytec_0 // 0x657363
    swap
    concat
    // contract.py:279-280
    // record = self.escrows[key].copy()
    // return record.status
    pushint 80
    intc_2 // 8
    box_extract // on error: index out of bounds
    // contract.py:275
    // @arc4.abimethod(readonly=True)
    pushbytes 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return


// algoease_escrow.contract.EscrowContract._send_escrow_payout(receiver: bytes, amount: bytes, asset_id: bytes) -> void:
_send_escrow_payout:
    // contract.py:182-188
    // @subroutine
    // def _send_escrow_payout(
    //     self,
    //     receiver: Account,
    //     amount: arc4.UInt64,
    //     asset_id: arc4.UInt64,
    // ) -> None:
    proto 3 0
    // contract.py:190
    // payout = amount.native
    frame_dig -2
    btoi
    dupn 2
    // contract.py:191
    // assert payout > 0, "no funds"
    assert // no funds
    // contract.py:192
    // app = Global.current_application_address
    global CurrentApplicationAddress
    // contract.py:193
    // available = app.balance - app.min_balance
    dup
    acct_params_get AcctBalance
    assert // account funded
    swap
    acct_params_get AcctMinBalance
    assert // account funded
    -
    // contract.py:194
    // assert available >= payout, "insufficient escrow liquidity"
    <=
    assert // insufficient escrow liquidity
    // contract.py:196
    // asset_native = asset_id.native
    frame_dig -1
    btoi
    dup
    cover 2
    // contract.py:197
    // if asset_native > 0:
    bz _send_escrow_payout_else_body@3
    // contract.py:198-203
    // itxn.AssetTransfer(
    //     xfer_asset=Asset(asset_native),
    //     asset_receiver=receiver,
    //     asset_amount=payout,
    //     fee=0,
    // ).submit()
    itxn_begin
    itxn_field AssetAmount
    frame_dig -3
    itxn_field AssetReceiver
    frame_dig 0
    itxn_field XferAsset
    // contract.py:198
    // itxn.AssetTransfer(
    pushint 4 // axfer
    itxn_field TypeEnum
    // contract.py:202
    // fee=0,
    intc_0 // 0
    itxn_field Fee
    // contract.py:198-203
    // itxn.AssetTransfer(
    //     xfer_asset=Asset(asset_native),
    //     asset_receiver=receiver,
    //     asset_amount=payout,
    //     fee=0,
    // ).submit()
    itxn_submit
    retsub

_send_escrow_payout_else_body@3:
    // contract.py:205-209
    // itxn.Payment(
    //     receiver=receiver,
    //     amount=payout,
    //     fee=0,
    // ).submit()
    itxn_begin
    itxn_field Amount
    frame_dig -3
    itxn_field Receiver
    // contract.py:205
    // itxn.Payment(
    intc_1 // pay
    itxn_field TypeEnum
    // contract.py:208
    // fee=0,
    intc_0 // 0
    itxn_field Fee
    // contract.py:205-209
    // itxn.Payment(
    //     receiver=receiver,
    //     amount=payout,
    //     fee=0,
    // ).submit()
    itxn_submit
    retsub


// algoease_escrow.contract.EscrowContract._refund_client(record: bytes, key: bytes) -> bytes:
_refund_client:
    // contract.py:211-212
    // @subroutine
    // def _refund_client(self, record: EscrowRecord, key: Bytes) -> None:
    proto 2 1
    // contract.py:214
    // assert record.amount.native > 0, "no funds"
    frame_dig -2
    extract 64 8
    frame_dig -2
    pushint 64
    extract_uint64
    assert // no funds
    // contract.py:215
    // client = record.client.native
    frame_dig -2
    extract 0 32
    // contract.py:216
    // del self.escrows[key]
    bytec_0 // 0x657363
    frame_dig -1
    concat
    box_del
    pop
    // contract.py:217
    // self._send_escrow_payout(client, record.amount, record.usdc_asset_id)
    frame_dig -2
    extract 72 8
    swap
    cover 2
    callsub _send_escrow_payout
    frame_dig -2
    retsub
