# AlgoEase v2 — Root env pointers
# Copy to .env and fill values. Each workspace has its own .env.example too.

# Algorand network
ALGORAND_NETWORK=testnet
ALGOD_TOKEN=
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
INDEXER_SERVER=https://testnet-idx.algonode.cloud

# Contract (backend reads ALGORAND_APP_ID; ESCROW_APP_ID is accepted as alias)
# Latest testnet deploy with reject_work: 762856134
ALGORAND_APP_ID=762856134
ESCROW_APP_ID=762856134
DEPLOYER_MNEMONIC=

# x402
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_NETWORK=algorand-testnet

# USDC-A ASA (testnet)
USDC_ASSET_ID=10458941

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# IPFS
NFT_STORAGE_API_KEY=
